        "foreground": "{{colors.on_surface.default.hex}}",
        "cursor": "{{colors.primary.default.hex}}"
      }
    }
  '';
  
  qutebrowserTemplate = ''
    # Qutebrowser theming generated by Matugen
    bg = "{{colors.surface.default.hex}}"
    bg_alt = "{{colors.surface_container.default.hex}}"
    bg_focused = "{{colors.primary.default.hex}}"
    fg = "{{colors.on_surface.default.hex}}"
    fg_alt = "{{colors.on_surface_variant.default.hex}}"
    fg_focused = "{{colors.on_primary.default.hex}}"
    accent = "{{colors.tertiary.default.hex}}"
    error = "{{colors.error.default.hex}}"

    # Completion
    c.colors.completion.category.bg = bg_alt
    c.colors.completion.category.fg = fg
    c.colors.completion.category.border.bottom = bg
    c.colors.completion.category.border.top = bg
    c.colors.completion.fg = fg_alt
    c.colors.completion.item.selected.bg = bg_focused
    c.colors.completion.item.selected.border.bottom = bg_focused
    c.colors.completion.item.selected.border.top = bg_focused
    c.colors.completion.item.selected.fg = fg_focused
    c.colors.completion.item.selected.match.fg = accent
    c.colors.completion.match.fg = accent
    c.colors.completion.scrollbar.bg = bg
    c.colors.completion.scrollbar.fg = fg

    # Statusbar
    c.colors.statusbar.normal.bg = bg
    c.colors.statusbar.normal.fg = fg

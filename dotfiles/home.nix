    c.colors.tabs.even.bg = bg
    c.colors.tabs.even.fg = fg
    c.colors.tabs.odd.bg = bg_alt
    c.colors.tabs.odd.fg = fg
    c.colors.tabs.selected.even.bg = bg_focused
    c.colors.tabs.selected.even.fg = fg_focused
    c.colors.tabs.selected.odd.bg = bg_focused
    c.colors.tabs.selected.odd.fg = fg_focused
  '';


{ pkgs, vars, ... }:

let
  qutebrowser = "${pkgs.qutebrowser}/bin/qutebrowser";

  # Matugen templates
  ewalTemplate = ''
    {
      "colors": {
        "color0": "{{colors.surface.default.hex}}",
        "color1": "{{colors.error.default.hex}}",
        "color2": "{{colors.primary.default.hex}}",
        "color3": "{{colors.tertiary.default.hex}}",
        "color4": "{{colors.secondary.default.hex}}",
        "color5": "{{colors.primary_fixed.default.hex}}",
        "color6": "{{colors.secondary_fixed.default.hex}}",
        "color7": "{{colors.on_surface.default.hex}}",
        "color8": "{{colors.outline.default.hex}}",
        "color9": "{{colors.error_container.default.hex}}",
        "color10": "{{colors.primary_container.default.hex}}",
        "color11": "{{colors.tertiary_container.default.hex}}",
        "color12": "{{colors.secondary_container.default.hex}}",
        "color13": "{{colors.inverse_primary.default.hex}}",
        "color14": "{{colors.inverse_surface.default.hex}}",
        "color15": "{{colors.surface_bright.default.hex}}"
      },
      "special": {
        "background": "{{colors.surface.default.hex}}",
        "foreground": "{{colors.on_surface.default.hex}}",
        "cursor": "{{colors.primary.default.hex}}"
      }
    }
  '';

  qutebrowserTemplate = ''
    # Qutebrowser theming generated by Matugen
    bg = "{{colors.surface.default.hex}}"
    bg_alt = "{{colors.surface_container.default.hex}}"
    bg_focused = "{{colors.primary.default.hex}}"
    fg = "{{colors.on_surface.default.hex}}"
    fg_alt = "{{colors.on_surface_variant.default.hex}}"
    fg_focused = "{{colors.on_primary.default.hex}}"
    accent = "{{colors.tertiary.default.hex}}"
    error = "{{colors.error.default.hex}}"

    # Completion
    c.colors.completion.category.bg = bg_alt
    c.colors.completion.category.fg = fg
    c.colors.completion.category.border.bottom = bg
    c.colors.completion.category.border.top = bg
    c.colors.completion.fg = fg_alt
    c.colors.completion.item.selected.bg = bg_focused
    c.colors.completion.item.selected.border.bottom = bg_focused
    c.colors.completion.item.selected.border.top = bg_focused
    c.colors.completion.item.selected.fg = fg_focused
    c.colors.completion.item.selected.match.fg = accent
    c.colors.completion.match.fg = accent
    c.colors.completion.scrollbar.bg = bg
    c.colors.completion.scrollbar.fg = fg

    # Statusbar
    c.colors.statusbar.normal.bg = bg
    c.colors.statusbar.normal.fg = fg
    c.colors.statusbar.insert.bg = accent
    c.colors.statusbar.insert.fg = fg_focused
    c.colors.statusbar.command.bg = bg
    c.colors.statusbar.command.fg = fg

    # Tabs
    c.colors.tabs.bar.bg = bg
    c.colors.tabs.even.bg = bg
    c.colors.tabs.even.fg = fg
    c.colors.tabs.odd.bg = bg_alt
    c.colors.tabs.odd.fg = fg
    c.colors.tabs.selected.even.bg = bg_focused
    c.colors.tabs.selected.even.fg = fg_focused
    c.colors.tabs.selected.odd.bg = bg_focused
    c.colors.tabs.selected.odd.fg = fg_focused
  '';

  footTemplate = ''
    [main]
    font=${vars.font}:size=14
    shell=/etc/profiles/per-user/jon/bin/nu
    pad=5x5

    [colors-dark]
    alpha = 0.9
    background = {{colors.surface.default.hex_stripped}}
    foreground = {{colors.on_surface.default.hex_stripped}}
    regular0 = {{colors.surface.default.hex_stripped}}
    regular1 = {{colors.error.default.hex_stripped}}
    regular2 = {{colors.primary.default.hex_stripped}}
    regular3 = {{colors.tertiary.default.hex_stripped}}
    regular4 = {{colors.secondary.default.hex_stripped}}
    regular5 = {{colors.primary_fixed.default.hex_stripped}}
    regular6 = {{colors.secondary_fixed.default.hex_stripped}}
    regular7 = {{colors.on_surface.default.hex_stripped}}

    bright0 = {{colors.outline.default.hex_stripped}}
    bright1 = {{colors.error_container.default.hex_stripped}}
    bright2 = {{colors.primary_container.default.hex_stripped}}
    bright3 = {{colors.tertiary_container.default.hex_stripped}}
    bright4 = {{colors.secondary_container.default.hex_stripped}}
    bright5 = {{colors.inverse_primary.default.hex_stripped}}
    bright6 = {{colors.inverse_surface.default.hex_stripped}}
    bright7 = {{colors.surface_bright.default.hex_stripped}}
  '';
in
{
  gtk = {
    enable = true;
    theme = {
      name = "Adwaita-dark";
      package = pkgs.gnome-themes-extra;
    };
    iconTheme = {
      name = "Flat-Remix-Black-Dark";
      package = pkgs.flat-remix-icon-theme;
    };
  };

  qt = {
    enable = true;
    platformTheme.name = "adwaita";
  };

  fonts.fontconfig = {
    enable = true;
    defaultFonts = {
      emoji = [ "Noto Color Emoji" ];
      monospace = [ vars.font ];
      sansSerif = [ "Liberation Sans" ];
      serif = [ "Liberation Serif" ];
    };
  };

  home.file = {
    ".config/matugen/templates/colors-ewal.json.template".text = ewalTemplate;
    ".config/matugen/templates/foot.ini.template".text = footTemplate;
    ".config/matugen/templates/qutebrowser-colors.py.template".text = qutebrowserTemplate;
  };

  xdg.configFile."matugen/config.toml".text = ''
    [config]

    [templates.ewal]
    input_path = '/home/jon/.config/matugen/templates/colors-ewal.json.template'
    output_path = '/home/jon/.cache/wal/colors.json'
    post_hook = "${vars.scripts}/theme-reload.nu --emacsclient ${vars.emacsclient}"

    [templates.foot]
    input_path = '/home/jon/.config/matugen/templates/foot.ini.template'
    output_path = '/home/jon/.config/foot/foot.ini'

    [templates.qutebrowser]
    input_path = '/home/jon/.config/matugen/templates/qutebrowser-colors.py.template'
    output_path = '/home/jon/.cache/dms-qute-config.py'
    post_hook = "${vars.scripts}/theme-reload.nu --qutebrowser ${qutebrowser}"
  '';
}
